{
  "manifest_version": 3,
  "name": "YouTube Auto Resizer & Quality Controller",
  "version": "2.1.0",
  "description": "自動調整 YouTube 播放器視訊尺寸與畫質，實現滿視窗貼合與零留白的最佳觀賞體驗。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Auto Resizer 設定"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/config.js", "src/layout.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "pageScript.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
