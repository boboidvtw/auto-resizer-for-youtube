{
  "manifest_version": 3,
  "name": "YouTube Auto Resizer & Quality Controller",
  "version": "2.0.0",
  "description": "自動調整 YouTube 播放器視訊尺寸與畫質，實現滿視窗貼合與零留白的最佳觀賞體驗。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Auto Resizer 設定"
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageScript.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
